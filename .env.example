# ── Core ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | sandbox | production
                                     # production serves PRODUCTION merchant accounts, all else SANDBOX
LOG_LEVEL=info
PUBLIC_BASE_URL=https://payment-gateway.example.com   # used for QStash targets and signature checks
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.neon.tech/db?sslmode=require   # Neon POOLED url

# ── OAuth (client credentials) ────────────────────────────────────────
# RS256/ES256 key pair (kid rotation). HS256 OAUTH_JWT_SECRET is for local development only
# and is refused when APP_ENV=production.
OAUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OAUTH_JWT_PUBLIC_KEY=
OAUTH_JWT_KID=k1
OAUTH_JWT_PUBLIC_KEY_PREV=           # during rotation: previous public key and its kid
OAUTH_JWT_KID_PREV=
OAUTH_JWT_SECRET=                    # local development only
OAUTH_TOKEN_TTL_SECONDS=600
CLIENT_SECRET_PEPPER=                # server pepper for HMAC-SHA-256 client secret hashes
ADMIN_API_TOKEN_HASH=                # sha256 hex of the admin bearer token

# ── QStash (replaces Vercel cron) ─────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Merchant credentials: one block per merchant_accounts.credential_ref prefix ──
KRN_PRIVATE_KEY=                     # SNAP: RSA private key (base64 body or PEM)
KRN_FASPAY_PUBLIC_KEY=               # SNAP: Faspay public key for callback verification
KRN_LEGACY_USER=                     # Legacy
KRN_LEGACY_PASSWORD=

# ── Consumer webhook secrets (payment_clients.webhook_secret_ref is the variable NAME) ──
CROWDFUNDING_WEBHOOK_SECRET=
# CROWDFUNDING_WEBHOOK_SECRET_PREV=  # set during rotation: both secrets sign

# ══ Open items from TRD section 20: all configurable, defaults shown ══
CALLBACK_VERIFY_MODE=SIGNATURE_AND_INQUIRY   # SIGNATURE once sandbox confirms the signature
SNAP_CALLBACK_SIGNATURE_HEADERS=X-SIGNATURE_FROM_FASPAY,X-SIGNATURE
SNAP_CALLBACK_PATH_MODES=path                # path | path_query | full_url (comma separated)
SNAP_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=600
SNAP_ALLOW_UNSIGNED_WITH_INQUIRY=true        # header missing: treat the callback as a hint
SNAP_DUPLICATE_ACK_MODE=SUCCESS              # SUCCESS | CONFLICT (documented 409SS01)
SNAP_QRIS_QUERY_SERVICE_CODE=51              # docs: 51, the existing code sends 47
SNAP_EWALLET_STATUS_SERVICE_CODE=55
SNAP_CHANNEL_ID=77001
# Deep-merged into request bodies per method (VA, QRIS, EWALLET, VA_INQUIRY, ...):
# SNAP_BODY_OVERRIDES={"VA":{"partnerServiceId":"88888"},"EWALLET":{"urlParam":[{"url":"https://...","type":"PAY_RETURN","isDeeplink":"N"}]}}
# Status tables: {"07":"RECORD"} stores the raw value without applying it.
# SNAP_STATUS_MAP_OVERRIDES={"07":"EXPIRED"}
# LEGACY_STATUS_MAP_OVERRIDES={"5":"RECORD"}
LEGACY_VERIFY_NOTIFICATION_SIGNATURE=false   # formula unconfirmed
LEGACY_REQUIRE_AMOUNT_FOR_SUCCESS=true
LEGACY_ACK_USE_INQUIRY_CODE=true
LEGACY_ERROR_RESPONSE_CODE=99
LEGACY_PAY_TYPE=1
LEGACY_TERMINAL=10
# LEGACY_BODY_OVERRIDES={}
# Product decisions (PRD 15): minutes
EXPIRES_DEFAULT_MINUTES_BY_PROTOCOL={"SNAP":300,"LEGACY":1440}
EXPIRES_MAX_MINUTES_BY_METHOD={"VA":10080,"QRIS":1440,"EWALLET":1440,"RETAIL":10080}
STALE_PENDING_MINUTES_BY_METHOD={"QRIS":15,"EWALLET":15,"VA":60,"RETAIL":360}
EXPIRY_FORCE_AFTER_MINUTES=0                 # 0: only inquiry-confirmed expiry
RETENTION_WEBHOOK_EVENT_DAYS=30
RETENTION_LONG_DAYS=365

# ── Tuning ────────────────────────────────────────────────────────────
FASPAY_CREATE_TIMEOUT_SECONDS=15
FASPAY_INQUIRY_TIMEOUT_SECONDS=8
STATUS_CACHE_TTL_SECONDS=30
RETRY_BASE_SECONDS=60
RETRY_CAP_SECONDS=21600
DELIVERY_MAX_ATTEMPTS=8
QSTASH_NUDGE_MIN_INTERVAL_SECONDS=5          # coalesces nudges to protect the QStash quota
ALLOW_INSECURE_WEBHOOK_URLS=false            # development and tests only
